<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duatic_rviz_highlight_joint_limits</name>
  <version>1.0.0</version>
  <description>RViz highlight: highlights links whose joint is close to a limit</description>

  <maintainer email="aroberti@duatic.com">Arturo Roberti</maintainer>
  <author email="aroberti@duatic.com">Arturo Roberti</author>
  <license>DCL-1</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>angles</depend>
  <depend>duatic_rviz_highlight</depend>
  <depend>generate_parameter_library</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>urdf</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
