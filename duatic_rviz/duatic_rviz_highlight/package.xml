<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duatic_rviz_highlight</name>
  <version>1.0.0</version>
  <description>RViz plugin that recolors the links of the RobotModel display, driven by highlight plugins</description>

  <author email="aroberti@duatic.com">Arturo Roberti</author>
  <maintainer email="aroberti@duatic.com">Arturo Roberti</maintainer>
  <license>DCL-1</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>generate_parameter_library</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>rviz_default_plugins</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
